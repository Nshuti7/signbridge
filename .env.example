# Copy this file to .env before `pnpm dev`.
# VITE_ variables are compiled into the browser bundle. Anyone who loads the
# site can read the key. Use a throwaway demo key locally. For a public
# deploy, proxy Gemma through a serverless function instead.
VITE_GEMMA_API_KEY=
VITE_GEMMA_MODEL=gemma-3-27b-it
